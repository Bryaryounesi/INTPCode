@overload
def sorted(
    iterable: Iterable[T],
    *,
    key: Optional[Callable[[T], Any]] = ...,
    reverse: bool = ...
) -> list: ...
@overload
def sorted(
    iterable: Iterable[T],
    cmp: Callable[[T, T], int],
    *,
    key: Optional[Callable[[T], Any]] = ...,
    reverse: bool = ...
) -> list: ...
def sorted(iterable: Iterable, *args: Any, **kwargs: Any) -> list:
    """
    📌 فرمول رایج:
    sorted([3, 1, 2])                    ← [1, 2, 3]
    sorted([3, 1, 2], reverse=True)      ← [3, 2, 1]
