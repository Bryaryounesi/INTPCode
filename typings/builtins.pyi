@overload
def min(arg1: T, arg2: T, *args: T, key: Optional[Callable[[T], Any]] = ...) -> T: ...
def min(*args: Any, **kwargs: Any) -> Any:
    """
    📌 فرمول رایج:
    min([12, 6, 5, 2, 7])                    ← 2
